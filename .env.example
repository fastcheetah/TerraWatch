PORT=3000
# demo: runs without a database; postgres: uses your team's PostgreSQL/PostGIS database
DATA_SOURCE=demo
# Required in postgres mode:
DATABASE_URL=postgres://postgres:password@localhost:5432/wildfires
# Only change to true when your managed database requires SSL; follow provider CA guidance.
DATABASE_SSL=false
# Measurement units MUST match the team's source/schema. Leave blank if unknown.
TEMPERATURE_UNIT=
BRIGHTNESS_UNIT=
# Optional database connection pool size
PG_POOL_SIZE=10
